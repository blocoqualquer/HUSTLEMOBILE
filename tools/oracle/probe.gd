extends SceneTree
func _init():
	var f = load("res://bin/FixedMath.gdns").new()
	print("mul 0.1*0.1 = ", f.mul("0.1","0.1"))
	print("div 1/3 = ", f.div("1","3"))
	print("div 2/3 = ", f.div("2","3"))
	print("1/3*3 = ", f.mul(f.div("1","3"),"3"))
	print("add 0.1+0.2 = ", f.add("0.1","0.2"))
	print("mul big 30000*30000 = ", f.mul("30000","30000"))
	print("mul 100000*100000 = ", f.mul("100000","100000"))
	print("0.000000000123 add 0 = ", f.add("0.000000000123","0"))
	print("tiny 0.00000000005 = ", f.add("0.00000000005","0"))
	print("2^-32 =", f.add("0.0000000002328306436538696289","0"))
	print("2^-16 =", f.add("0.0000152587890625","0"))
	print("vec_len 3,4: ", f.vec_len("3","4"))
	print("sqrt2: ", f.vec_len("1","1"))
	print("deg2rad 90: ", f.deg2rad("90"))
	print("round 2.5: ", f.round("2.5"), " round -2.5: ", f.round("-2.5"), " floor -0.5:", f.floor("-0.5"))
	print("powu 1.1^10: ", f.powu("1.1",10))
	print("div by zero: ", f.div("1","0"))
	print("normalized 3,4: ", f.normalized_vec("3","4"))
	quit()
